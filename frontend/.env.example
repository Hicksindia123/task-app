# Public Google Apps Script Web App Deployment URL
# Copy this file to .env.local and replace with your deployed Apps Script Web App URL:
# Example: https://script.google.com/macros/s/AKfycbx.../exec
VITE_GAS_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional base path for GitHub Pages deployment (e.g., /task-delegation-app/)
VITE_BASE_PATH=/task-delegation-app/

# Set to 'false' in production so the frontend strictly requires the live Google Apps Script backend.
# Set to 'true' only for local offline previewing.
VITE_ENABLE_LOCAL_FALLBACK=false
